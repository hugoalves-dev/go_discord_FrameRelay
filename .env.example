DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: registers the slash command in one server for immediate development updates.
DISCORD_GUILD_ID=
RELAYCONTROL_BASE_URL=https://relay.example.com
RELAYCONTROL_SERVICE_TOKEN=
HTTP_ADDR=:8080
SHARE_INTENT_TTL=10m
WATCH_INTENT_TTL=30m
